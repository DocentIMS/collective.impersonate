<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/@@main_template/macros/master"
>

  <metal:block fill-slot="content-core"
               tal:define="
                 portal_state context/@@plone_portal_state;
                 navRoot portal_state/portal_url;
                 errors view/errors | nothing;
                 many_users view/many_users;
               "
               i18n:domain="collective.impersonate"
  >
    <style>
      /* Keep the page (the white box) narrow: it is a short list. */
      body.template-impersonate #content,
      body.template-impersonate main > article { max-width: 640px; margin-left: auto; margin-right: auto; }
      .impersonate-form .impersonate-bar { display: flex; gap: .5rem; align-items: center; margin-bottom: 1rem; }
      .impersonate-form .impersonate-bar input[type="search"],
      .impersonate-form .impersonate-bar input[type="text"] { flex: 1 1 auto; min-width: 0; }
      .impersonate-form table.listing { width: 100%; }
      .impersonate-form td.impersonate-pick,
      .impersonate-form th.impersonate-pick { width: 2.5rem; text-align: center; }
      .impersonate-form tr.impersonate-user { cursor: pointer; }
      .impersonate-form .impersonate-none { display: none; padding: .75rem 0; }
    </style>

    <h5 i18n:translate="impersonate_warning">This is an admin-only form for impersonating other users. Please use it wisely.</h5>
    <br />

    <form class="impersonate-form"
          action="${request/getURL}"
          method="post"
    >
      <input tal:replace="structure context/@@authenticator/authenticator" />

      <div class="field error"
           tal:define="
             error errors/username | nothing;
           "
           tal:condition="error"
           i18n:translate="form_choose_error"
      >User "<span tal:replace="error"
              i18n:name="from_choose_user"
        ></span>" does not exist.</div>
      <div class="field error"
           tal:condition="errors/missing | nothing"
           i18n:translate="form_choose_missing"
      >Choose a user first.</div>

      <!-- Few users: search box narrows the list, the radio button picks. -->
      <tal:few condition="not: many_users">
        <div class="impersonate-bar">
          <input id="impersonate-search"
                 aria-label="Search"
                 autocomplete="off"
                 autofocus="autofocus"
                 placeholder="Search"
                 type="search"
                 i18n:attributes="placeholder; aria-label"
          />
          <input class="btn btn-primary"
                 name="impersonate"
                 type="submit"
                 value="Impersonate"
                 i18n:attributes="value"
          />
        </div>

        <table class="listing"
               id="impersonate-users"
        >
          <thead>
            <tr>
              <th class="impersonate-pick"></th>
              <th i18n:translate="list_users">User ID</th>
              <th i18n:translate="list_users_fullname">Full name</th>
            </tr>
          </thead>
          <tbody>
            <tr class="impersonate-user"
                tal:repeat="user view/users"
            >
              <td class="impersonate-pick">
                <input name="username"
                       required="required"
                       type="radio"
                       tal:attributes="
                         value user/username;
                         aria-label user/username;
                       "
                />
              </td>
              <td tal:content="user/username"></td>
              <td tal:content="user/fullname"></td>
            </tr>
          </tbody>
        </table>
        <p class="impersonate-none"
           id="impersonate-none"
           i18n:translate="search_no_match"
        >No user matches.</p>

        <script>
          (function () {
            var box = document.getElementById("impersonate-search");
            var rows = document.querySelectorAll("#impersonate-users tr.impersonate-user");
            var none = document.getElementById("impersonate-none");
            function filter() {
              var words = box.value.toLowerCase().split(/\s+/).filter(Boolean);
              var shown = [];
              rows.forEach(function (row) {
                var text = row.textContent.toLowerCase();
                var hit = words.every(function (w) { return text.indexOf(w) !== -1; });
                row.style.display = hit ? "" : "none";
                var radio = row.querySelector("input[type=radio]");
                if (hit) { shown.push(radio); } else { radio.checked = false; }
              });
              // One left: pick it, so typing a name and pressing Enter works.
              if (shown.length === 1 && words.length) { shown[0].checked = true; }
              none.style.display = shown.length ? "none" : "block";
            }
            box.addEventListener("input", filter);
            rows.forEach(function (row) {
              row.addEventListener("click", function () {
                row.querySelector("input[type=radio]").checked = true;
              });
            });
          })();
        </script>
      </tal:few>

      <!-- "Many users" sites do not list everybody: type the exact user ID. -->
      <tal:many condition="many_users">
        <div class="impersonate-bar">
          <input id="username"
                 aria-label="User ID"
                 name="username"
                 placeholder="User ID"
                 required="required"
                 type="text"
                 tal:attributes="
                   value request/username | nothing;
                 "
                 i18n:attributes="placeholder; aria-label"
          />
          <input class="btn btn-primary"
                 name="impersonate"
                 type="submit"
                 value="Impersonate"
                 i18n:attributes="value"
          />
        </div>
        <p>
          <span i18n:translate="to_search_for_a_user">To search for a user, use the
          </span>
          <a target="_blank"
             tal:attributes="
               href python: navRoot + '/@@usergroup-userprefs';
             "
             i18n:translate="users_and_groups_control_panel"
          >
            Users and Groups control panel
          </a>
        </p>
      </tal:many>
    </form>

  </metal:block>

</html>
